        "from sklearn.naive_bayes import GaussianNB\n",
        "\n",
        "X = [\n",
        "    [20000, 500],\n",
        "    [25000, 550],\n",
        "    [60000, 700],\n",
        "    [80000, 750],\n",
        "    [90000, 800]\n",
        "]\n",
        "\n",
        "y = ['No', 'No', 'Yes', 'Yes', 'Yes']\n",
        "\n",
        "model = GaussianNB()\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Loan Prediction:\", model.predict([[65000, 720]])[0])"
