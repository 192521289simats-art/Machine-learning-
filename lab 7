        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "X = [[1], [2], [3], [4], [5], [6]]\n",
        "y = [0, 0, 0, 1, 1, 1]\n",
        "\n",
        "model = LogisticRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Prediction:\", model.predict([[5]])[0])\n",
        "print(\"Accuracy:\", model.score(X, y))"
      ]
    }
