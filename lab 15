        "from sklearn.datasets import load_iris\n",
        "from sklearn.naive_bayes import GaussianNB\n",
        "\n",
        "iris = load_iris()\n",
        "\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "\n",
        "model = GaussianNB()\n",
        "model.fit(X, y)\n",
        "\n",
        "p = model.predict([X[0]])\n",
        "\n",
        "print(\"Prediction:\", iris.target_names[p[0]])\n",
        "print(\"Accuracy:\", model.score(X, y))"
      ]
