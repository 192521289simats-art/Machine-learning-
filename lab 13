        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "X = [\n",
        "    [1, 10000],\n",
        "    [2, 20000],\n",
        "    [3, 30000],\n",
        "    [4, 40000],\n",
        "    [5, 50000]\n",
        "]\n",
        "\n",
        "y = [900000, 800000, 700000, 600000, 500000]\n",
        "\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Predicted Price:\", model.predict([[2, 15000]])[0])"
