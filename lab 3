        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "X = [[0,0], [0,1], [1,0], [1,1]]\n",
        "y = ['No', 'Yes', 'Yes', 'Yes']\n",
        "\n",
        "model = DecisionTreeClassifier(criterion='entropy')\n",
        "model.fit(X, y)\n",
        "\n",
        "sample = [[1, 0]]\n",
        "print(\"Prediction:\", model.predict(sample)[0])"
      ]
