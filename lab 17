        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "X = [\n",
        "    [2, 3000],\n",
        "    [3, 4000],\n",
        "    [4, 6000],\n",
        "    [6, 8000],\n",
        "    [8, 12000]\n",
        "]\n",
        "\n",
        "y = [0, 1, 1, 2, 3]\n",
        "\n",
        "model = DecisionTreeClassifier()\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Price Range:\", model.predict([[6, 7000]])[0])"
